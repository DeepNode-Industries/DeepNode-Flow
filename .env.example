# DeepNode Flow — Variables de entorno (ejemplo)
# Copia este archivo como .env.local y completa con tus credenciales reales

# ─── Inteligencia Artificial ───────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# xAI — Grok (compatible con OpenAI SDK)
# Obtén tu key en: https://console.x.ai/
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxx

# ─── Telegram Bot API ─────────────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram → /newbot → copia el token
# 2. Envía /start a tu bot para obtener el chat_id
# 3. Registra el webhook: https://api.telegram.org/bot{TOKEN}/setWebhook?url=https://tudominio.com/api/webhooks/telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── WhatsApp Business (Meta Cloud API) ───────────────────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_123

# ─── Email SMTP ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu-app-password

# ─── Stripe Payments ───────────────────────────────────────────────────────
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
# Formato: sk_test_... (pruebas) o sk_live_... (producción)
STRIPE_SECRET_KEY=tu_stripe_secret_key_aqui
STRIPE_WEBHOOK_SECRET=tu_stripe_webhook_secret_aqui

# URL pública de la app (Vercel te da esta URL automáticamente)
NEXT_PUBLIC_APP_URL=https://tuapp.vercel.app

# Price IDs — créalos en Stripe Dashboard → Products → Add Product
# Pro Plan
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_mensual_aqui
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_anual_aqui
# Business Plan
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_business_mensual_aqui
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_business_anual_aqui

# Clave pública Stripe (segura para el cliente)
# Formato: pk_test_... (pruebas) o pk_live_... (producción)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=tu_stripe_publishable_key_aqui
